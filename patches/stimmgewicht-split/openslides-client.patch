+// Loads the repositories first to avoid an import cycle when this spec runs alone.
+import '@app/site/modules/wait-for-action-dialog/services/wait-for-action-dialog.service';
+
+import { PollType } from '@app/domain/models/poll';
+
+import { BasePollVoteComponent, SplitBallot } from './base-poll-vote.component';
+
+/**
+ * Tests the split vote logic without rendering the component.
+ */
+describe(`BasePollVoteComponent split votes`, () => {
+    const proto = BasePollVoteComponent.prototype as any;
+    let ctx: any;
+    let sent: any;
+    const user = { id: 7, default_vote_weight: 4, getMeetingUser: (): any => ({ vote_weight: 4 }) };
+
+    beforeEach(() => {
+        sent = undefined;
+        ctx = Object.create(proto);
+        Object.assign(ctx, {
+            _poll: {
+                isAssignmentPoll: true,
+                isMethodY: true,
+                isMethodN: false,
+                type: PollType.Named,
+                max_votes_amount: 2,
+                max_votes_per_option: 1,
+                min_votes_amount: 1,
+                option_ids: [1, 2, 3],
+                meeting_id: 1
+            },
+            voteWeightEnabled: true,
+            splitBallots: {},
+            deliveringVote: {},
+            user,
+            cd: { markForCheck: (): void => {} },
+            translate: { instant: (s: string): string => s },
+            raiseError: jasmine.createSpy(`raiseError`),
+            splitVotePrompt: { open: async (): Promise<boolean> => true },
+            sendVote: async (_id: number, payload: any): Promise<void> => {
+                sent = payload;
+            }
+        });
+    });
+
+    it(`is only offered in elections`, () => {
+        expect(ctx.canSplitVote(user)).toBeTrue();
+        ctx.poll.isAssignmentPoll = false;
+        expect(ctx.canSplitVote(user)).toBeFalse();
+    });
+
+    it(`is not offered with a single vote`, () => {
+        const single = { ...user, getMeetingUser: (): any => ({ vote_weight: 1 }) };
+        expect(ctx.canSplitVote(single)).toBeFalse();
+    });
+
+    it(`creates one ballot per vote`, () => {
+        ctx.toggleSplitVote(user);
+        expect(ctx.getSplitBallots(user).length).toBe(4);
+    });
+
+    it(`respects the maximum votes per ballot`, () => {
+        ctx.toggleSplitVote(user);
+        const ballot: SplitBallot = ctx.getSplitBallots(user)[0];
+        ctx.toggleBallotOption(ballot, 1, `Y`);
+        ctx.toggleBallotOption(ballot, 2, `Y`);
+        ctx.toggleBallotOption(ballot, 3, `Y`);
+        expect(ballot.options).toEqual({ 1: 1, 2: 1 });
+        expect(ctx.raiseError).toHaveBeenCalled();
+    });
+
+    it(`replaces candidates with a general abstention and back`, () => {
+        ctx.toggleSplitVote(user);
+        const ballot: SplitBallot = ctx.getSplitBallots(user)[0];
+        ctx.toggleBallotOption(ballot, 1, `Y`);
+        ctx.toggleBallotGlobal(ballot, `A`);
+        expect(ballot).toEqual({ options: {}, global: `A` });
+        ctx.toggleBallotOption(ballot, 2, `Y`);
+        expect(ballot.global).toBeUndefined();
+        expect(ballot.options).toEqual({ 2: 1 });
+    });
+
+    it(`sends only when every ballot is filled out and merges equal ballots`, async () => {
+        ctx.toggleSplitVote(user);
+        const [b1, b2, b3, b4] = ctx.getSplitBallots(user) as SplitBallot[];
+        ctx.toggleBallotOption(b1, 1, `Y`);
+        ctx.toggleBallotOption(b1, 2, `Y`);
+        ctx.toggleBallotOption(b2, 2, `Y`);
+        ctx.toggleBallotOption(b2, 1, `Y`);
+        ctx.toggleBallotGlobal(b3, `A`);
+        expect(ctx.isSplitVoteComplete(user)).toBeFalse();
+        await ctx.submitSplitVote(user);
+        expect(sent).toBeUndefined();
+
+        ctx.toggleBallotOption(b4, 3, `Y`);
+        expect(ctx.isSplitVoteComplete(user)).toBeTrue();
+        await ctx.submitSplitVote(user);
+        expect(sent).toEqual({
+            user_id: 7,
+            split: [
+                { weight: `2.000000`, value: { 1: 1, 2: 1 } },
+                { weight: `1.000000`, value: `A` },
+                { weight: `1.000000`, value: { 3: 1 } }
+            ]
+        });
+    });
+});
