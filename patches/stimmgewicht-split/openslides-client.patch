+    /**
+     * The vote weight of a user like the vote service calculates it.
+     */
+    public getVoteWeight(user: ViewUser = this.user): number {
+        if (!this.voteWeightEnabled) {
+            return 1;
+        }
+        const meetingUserWeight = Number(user?.getMeetingUser(this.poll.meeting_id)?.vote_weight);
+        return meetingUserWeight || Number(user?.default_vote_weight) || 1;
+    }
+
+    /**
+     * A user can split their vote weight between yes, no and abstain like they
+     * could split their paper ballots. This is possible for polls with a single
+     * option, if the user has more than one vote.
+     */
+    public canSplitVote(user: ViewUser = this.user): boolean {
+        return (
+            this.poll.type !== PollType.Analog &&
+            (this.poll.isMethodYN || this.poll.isMethodYNA) &&
+            this.poll.option_ids?.length === 1 &&
+            this.getVoteWeight(user) > 1
+        );
+    }
+
+    public isSplitVoteActive(user: ViewUser = this.user): boolean {
+        return !!this.splitVoteAmounts[user?.id];
+    }
+
+    public toggleSplitVote(user: ViewUser = this.user): void {
+        if (this.isSplitVoteActive(user)) {
+            delete this.splitVoteAmounts[user.id];
+        } else {
+            this.splitVoteAmounts[user.id] = {};
+        }
+        this.cd.markForCheck();
+    }
+
+    public setSplitVoteAmount(vote: VoteValue, event: any, user: ViewUser = this.user): void {
+        const amount = Number(event.target.value);
+        this.splitVoteAmounts[user.id][vote] = isNaN(amount) || amount < 0 ? 0 : amount;
+        this.cd.markForCheck();
+    }
+
+    public getSplitVoteSum(user: ViewUser = this.user): number {
+        return this.toMicroVotes(Object.values(this.splitVoteAmounts[user?.id] ?? {})) / 1e6;
+    }
+
+    public isSplitVoteComplete(user: ViewUser = this.user): boolean {
+        return (
+            this.toMicroVotes(Object.values(this.splitVoteAmounts[user?.id] ?? {})) ===
+            this.toMicroVotes([this.getVoteWeight(user)])
+        );
+    }
+
+    public async submitSplitVote(user: ViewUser = this.user): Promise<void> {
+        if (!this.isSplitVoteComplete(user)) {
+            return;
+        }
+
+        const optionId = this.poll.option_ids[0];
+        const split = Object.entries(this.splitVoteAmounts[user.id])
+            .filter(([, amount]) => amount > 0)
+            .map(([vote, amount]) => ({
+                weight: (this.toMicroVotes([amount]) / 1e6).toFixed(6),
+                value: { [optionId]: vote }
+            }));
+
+        const title = this.translate.instant(`Submit selection now?`);
+        const content = this.translate.instant(`Your decision cannot be changed afterwards.`);
+        if (!(await this.splitVotePrompt.open(title, content))) {
+            return;
+        }
+
+        this.deliveringVote[user.id] = true;
+        this.cd.markForCheck();
+        await this.sendVote(user.id, { user_id: user.id, split });
+    }
+
+    /**
+     * Sums up vote amounts as integers with six decimal places, like the vote
+     * service does, to avoid floating point errors.
+     */
+    private toMicroVotes(amounts: number[]): number {
+        return amounts.reduce((sum, amount) => sum + Math.round((amount || 0) * 1e6), 0);
+    }
