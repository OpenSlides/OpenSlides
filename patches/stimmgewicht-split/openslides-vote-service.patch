+
+func TestVoteSplit(t *testing.T) {
+	pollData := `
+	poll/1:
+		meeting_id: 1
+		entitled_group_ids: [1]
+		pollmethod: YNA
+		option_ids: [1]
+		backend: fast
+		type: named
+		content_object_id: some_field/1
+		sequential_number: 1
+		onehundred_percent_base: base
+		title: myPoll
+
+	option/1/meeting_id: 1
+
+	user/1:
+		is_present_in_meeting_ids: [1]
+		meeting_user_ids: [10]
+		default_vote_weight: "4.000000"
+	meeting_user/10:
+		group_ids: [1]
+		meeting_id: 1
+	`
+
+	for _, tt := range []struct {
+		name          string
+		weightEnabled bool
+		vote          string
+
+		expectErr   string
+		expectSplit []string
+	}{
+		{
+			"Valid split",
+			true,
+			`{"split":[{"weight":"2","value":{"1":"Y"}},{"weight":"1","value":{"1":"N"}},{"weight":"1","value":{"1":"A"}}]}`,
+			"",
+			[]string{"2.000000", "1.000000", "1.000000"},
+		},
+		{
+			"Weight as number",
+			true,
+			`{"split":[{"weight":3.5,"value":{"1":"Y"}},{"weight":0.5,"value":{"1":"N"}}]}`,
+			"",
+			[]string{"3.500000", "0.500000"},
+		},
+		{
+			"Weight disabled",
+			false,
+			`{"split":[{"weight":"1","value":{"1":"Y"}}]}`,
+			"Split votes are only allowed if vote weight is enabled",
+			nil,
+		},
+		{
+			"Sum too small",
+			true,
+			`{"split":[{"weight":"2","value":{"1":"Y"}},{"weight":"1","value":{"1":"N"}}]}`,
+			"The weights of the split vote sum up to 3.000000, but your vote weight is 4.000000",
+			nil,
+		},
+		{
+			"Sum too big",
+			true,
+			`{"split":[{"weight":"4","value":{"1":"Y"}},{"weight":"1","value":{"1":"N"}}]}`,
+			"The weights of the split vote sum up to 5.000000, but your vote weight is 4.000000",
+			nil,
+		},
+		{
+			"Zero weight",
+			true,
+			`{"split":[{"weight":"4","value":{"1":"Y"}},{"weight":"0","value":{"1":"N"}}]}`,
+			"The weight of part 2 has to be greater than 0",
+			nil,
+		},
+		{
+			"Negative weight",
+			true,
+			`{"split":[{"weight":"5","value":{"1":"Y"}},{"weight":"-1","value":{"1":"N"}}]}`,
+			"The weight of part 2 has to be greater than 0",
+			nil,
+		},
+		{
+			"Too many decimals",
+			true,
+			`{"split":[{"weight":"3.9999995","value":{"1":"Y"}},{"weight":"0.0000005","value":{"1":"N"}}]}`,
+			"The weight of part 1 can have at most 6 decimal places",
+			nil,
+		},
+		{
+			"Invalid part",
+			true,
+			`{"split":[{"weight":"2","value":{"1":"Y"}},{"weight":"2","value":{"2":"N"}}]}`,
+			"Part 2: Option_id 2 does not belong to the poll",
+			nil,
+		},
+		{
+			"Empty split",
+			true,
+			`{"split":[]}`,
+			"A split vote needs at least one part",
+			nil,
+		},
+		{
+			"Split and value",
+			true,
+			`{"value":{"1":"Y"},"split":[{"weight":"4","value":{"1":"Y"}}]}`,
+			"A split vote can not have a value",
+			nil,
+		},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx := context.Background()
+			backend := memory.New()
+			data := pollData + fmt.Sprintf("\n\tmeeting/1/users_enable_vote_weight: %t\n", tt.weightEnabled)
+			ds := &StubGetter{data: dsmock.YAMLData(data)}
+			v, _, _ := vote.New(ctx, backend, backend, ds, true)
+
+			if err := backend.Start(ctx, 1); err != nil {
+				t.Fatalf("bakckend.Start: %v", err)
+			}
+
+			err := v.Vote(ctx, 1, 1, strings.NewReader(tt.vote))
+
+			if tt.expectErr != "" {
+				if !errors.Is(err, vote.ErrInvalid) {
+					t.Fatalf("expected ErrInvalid, got: %v", err)
+				}
+
+				if !strings.Contains(err.Error(), tt.expectErr) {
+					t.Errorf("got error %q, expected %q", err.Error(), tt.expectErr)
+				}
+				return
+			}
+
+			if err != nil {
+				t.Fatalf("vote returned unexpected error: %v", err)
+			}
+
+			stored, _, _ := backend.Stop(ctx, 1)
+			if len(stored) != 1 {
+				t.Fatalf("got %d vote objects, expected one", len(stored))
+			}
+
+			var decoded struct {
+				Value  json.RawMessage `json:"value"`
+				Weight string          `json:"weight"`
+				Split  []struct {
+					Value  json.RawMessage `json:"value"`
+					Weight string          `json:"weight"`
+				} `json:"split"`
+			}
+			if err := json.Unmarshal(stored[0], &decoded); err != nil {
+				t.Fatalf("decoding voteobject returned unexpected error: %v", err)
+			}
+
+			if decoded.Weight != "4.000000" {
+				t.Errorf("got total weight %q, expected 4.000000", decoded.Weight)
+			}
+
+			if string(decoded.Value) != "null" {
+				t.Errorf("got value %s, expected null", decoded.Value)
+			}
+
+			if len(decoded.Split) != len(tt.expectSplit) {
+				t.Fatalf("got %d split parts, expected %d", len(decoded.Split), len(tt.expectSplit))
+			}
+
+			for i, w := range tt.expectSplit {
+				if decoded.Split[i].Weight != w {
+					t.Errorf("part %d: got weight %q, expected %q", i+1, decoded.Split[i].Weight, w)
+				}
+			}
+		})
+	}
+}
