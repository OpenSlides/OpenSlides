 type ballot struct {
 	UserID maybeInt    `json:"user_id"`
 	Value  ballotValue `json:"value"`
+
+	// Split divides the vote weight of the user into parts with different
+	// values. It is the electronic version of handing out one paper ballot
+	// for each vote of the vote weight.
+	Split []splitPart `json:"split"`
+}
+
+// splitPart is one part of a split vote.
+type splitPart struct {
+	Weight decimal.Decimal `json:"weight"`
+	Value  ballotValue     `json:"value"`
+}
+
+// splitVoteData is one part of a split vote, how it is saved in the backend.
+type splitVoteData struct {
+	Value  json.RawMessage `json:"value"`
+	Weight string          `json:"weight"`
+}
+
+// maxSplitParts is the maximum amount of parts a split vote can have.
+const maxSplitParts = 100
+
+// validateSplit validates a split vote. Each part has to be a valid vote and
+// the weights of all parts have to sum up to the vote weight of the user.
+func validateSplit(poll dsmodels.Poll, split []splitPart, voteWeight decimal.Decimal) string {
+	if len(split) == 0 {
+		return "A split vote needs at least one part"
+	}
+
+	if len(split) > maxSplitParts {
+		return fmt.Sprintf("A split vote can have at most %d parts", maxSplitParts)
+	}
+
+	sum := decimal.Zero
+	for i, part := range split {
+		if !part.Weight.IsPositive() {
+			return fmt.Sprintf("The weight of part %d has to be greater than 0", i+1)
+		}
+
+		if !part.Weight.Equal(part.Weight.Truncate(6)) {
+			return fmt.Sprintf("The weight of part %d can have at most 6 decimal places", i+1)
+		}
+
+		if validation := validate(poll, part.Value); validation != "" {
+			return fmt.Sprintf("Part %d: %s", i+1, validation)
+		}
+
+		sum = sum.Add(part.Weight)
+	}
+
+	if !sum.Equal(voteWeight) {
+		return fmt.Sprintf("The weights of the split vote sum up to %s, but your vote weight is %s", sum.StringFixed(6), voteWeight.StringFixed(6))
+	}
+
+	return ""
 }
 
 func (v ballot) String() string {
